       RowBox[{"0", ",", "rmax", ",", "nx"}], "]"}], ",", 
      RowBox[{"NRange", "[", 
       RowBox[{"0", ",", "1", ",", "ny"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fr1", "=", 
   RowBox[{"MeshPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", " ", "y"}]}], "]"}], ",", 
       RowBox[{"n", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", " ", "y"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", "mesh"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fr2", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"fr1", ",", 
     RowBox[{"MeshRotate", "[", 
      RowBox[{"fr1", ",", 
       RowBox[{"StraightLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fr3", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"fr2", ",", 
     RowBox[{"MeshReflect", "[", 
      RowBox[{"fr2", ",", 
       RowBox[{"Plane", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"Pi", "/", "2"}], "/", "k"}], "]"}], ",", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"Pi", "/", "2"}], "/", "k"}], "]"}], ",", "0"}], "}"}], 
         ",", "0"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fr4", "=", 
   RowBox[{"MeshJoin", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"MeshRotateZ", "[", 
       RowBox[{"fr3", ",", 
        RowBox[{"2", "Pi", " ", 
         RowBox[{"i", "/", "k"}]}], ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fr5", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"fr4", ",", 
     RowBox[{"MeshReflect", "[", 
      RowBox[{"fr4", ",", 
       RowBox[{"Plane", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"\[Delta]0", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fr6", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"fr5", ",", 
     RowBox[{"MeshTranslate", "[", 
      RowBox[{"fr5", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"4", 
          RowBox[{"\[Delta]0", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
     RowBox[{"MeshTranslate", "[", 
      RowBox[{"fr5", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{
          RowBox[{"-", "4"}], 
          RowBox[{"\[Delta]0", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FR3", "=", "fr6"}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PoVExport", "[", 
   RowBox[{"\"\<dummy\>\"", ",", "FR0", ",", "FR1", ",", "FR3", ",", "FR2"}], 
