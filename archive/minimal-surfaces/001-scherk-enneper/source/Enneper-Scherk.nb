Notebook[{

Cell[CellGroupData[{
Cell["Singly Periodic Scherk Surface with Enneper Ends", "Title",
 CellChangeTimes->{{3.674044467498411*^9, 3.674044483334445*^9}, 
   3.674044734066428*^9},ExpressionUUID->"6518806b-7a52-4c28-a545-\
ea9126db02b5"],

Cell["\<\
Ends at roots of unity. Gauss map is horizontal there. High order points with \
vertical normal at 0 and \[Infinity]. Additional zeroes at parameter points \
a. Unit circle lies on horizontal symmetry plane.\
\>", "Text",
 CellChangeTimes->{{3.674044520106422*^9, 3.674044607681046*^9}, {
  3.6740463280002527`*^9, 3.674046334525339*^9}, {3.735455290193686*^9, 
  3.73545529296992*^9}},ExpressionUUID->"05c8382e-f69e-40fc-97f2-\
4df52ea93fe8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{"1", "-", 
     SuperscriptBox["a", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "k"}]]}], 
    RowBox[{"1", "-", 
     SuperscriptBox["a", 
      RowBox[{"2", " ", "k"}]]}]], 
   FractionBox[
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{"k", "-", "1"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{"2", "k"}]], "-", 
       SuperscriptBox["a", 
        RowBox[{"2", "k"}]]}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["z", 
       RowBox[{"2", "k"}]], "-", 
      RowBox[{"1", "/", 
       SuperscriptBox["a", 
        RowBox[{"2", "k"}]]}]}], ")"}]]}]}]], "Input",
 CellChangeTimes->{{3.67404477123662*^9, 3.6740447754662*^9}, {
   3.6740462677675943`*^9, 3.674046288489916*^9}, 3.674046362787435*^9, {
   3.6740473368596563`*^9, 
   3.6740473697771673`*^9}},ExpressionUUID->"e9b2359a-0c73-43fb-b0c6-\
da9888fa0bb8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dh", "[", "z_", "]"}], ":=", 
  RowBox[{"I", 
   FractionBox[
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{"2", "k"}]], "-", 
       SuperscriptBox["a", 
        RowBox[{"2", "k"}]]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{"2", "k"}]], "-", 
       RowBox[{"1", "/", 
        SuperscriptBox["a", 
         RowBox[{"2", "k"}]]}]}], ")"}]}], 
    RowBox[{" ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["z", 
         RowBox[{"2", "k"}]], "-", "1"}], ")"}], "3"]}]]}]}]], "Input",
 CellChangeTimes->{
  3.674044762237095*^9, {3.6740447993739853`*^9, 3.674044829253263*^9}, {
   3.674046297615231*^9, 3.6740463120822077`*^9}, 3.6740464228062353`*^9, {
   3.674047340661997*^9, 
   3.674047344385642*^9}},ExpressionUUID->"a8d1de72-afe0-4bea-86d0-\
ec83612b5af8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phi1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"G", "[", "z", "]"}], 
    RowBox[{"dh", "[", "z", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phi2", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"G", "[", "z", "]"}]}], 
    RowBox[{"dh", "[", "z", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.674046665920164*^9, 
  3.67404668046815*^9}},ExpressionUUID->"d2c60ae5-8471-47b2-a496-\
b4d065c5c768"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]1", "[", "z_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{"phi2", "[", "z", "]"}], "-", 
      RowBox[{"phi1", "[", "z", "]"}]}], " ", ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]2", "[", "z_", "]"}], " ", ":=", 
   RowBox[{"I", 
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"phi2", "[", "z", "]"}], "+", 
       RowBox[{"phi1", "[", "z", "]"}]}], ")"}], "/", "2"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]3", "[", "z_", "]"}], ":=", 
  RowBox[{"dh", "[", "z", "]"}]}]}], "Input",ExpressionUUID->"731d03de-e435-\
4996-81d5-7568eeff0fbb"],

