bcaaa11b87e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mp3", "=", 
   RowBox[{"MeshJoin", "@@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"EvenQ", "[", 
          RowBox[{"j", "+", "i"}], "]"}], ",", 
         RowBox[{"MeshRotateZ", "[", 
          RowBox[{"mp2", ",", 
           RowBox[{
            RowBox[{"2", "a", " ", "Pi", " ", "j"}], "-", 
            RowBox[{"2", "Pi", " ", 
             RowBox[{"i", "/", "k"}]}]}], ",", 
           RowBox[{"j", " ", "trans"}]}], "]"}], ",", 
         RowBox[{"MeshFlip", "[", 
          RowBox[{"MeshRotateZ", "[", 
           RowBox[{"mp2", ",", 
            RowBox[{
             RowBox[{"2", "a", " ", "Pi", " ", "j"}], "-", 
             RowBox[{"2", "Pi", " ", 
              RowBox[{"i", "/", "k"}]}]}], ",", 
            RowBox[{"j", " ", "trans"}]}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.6726579536016083`*^9, 3.672658005937235*^9}, 
   3.6726580384585657`*^9, 3.672658301083981*^9, {3.672658375106605*^9, 
   3.672658375488852*^9}},ExpressionUUID->"24f2c33e-bd92-42f9-b52b-\
f01b637b1ec2"],

