Cell[BoxData[
 RowBox[{
  RowBox[{"m1", "=", 
   RowBox[{"RectangularDomain", "[", "\[IndentingNewLine]", 
    RowBox[{"xr", ",", "\[IndentingNewLine]", 
     RowBox[{"NRange", "[", 
      RowBox[{"eps", ",", 
       RowBox[{"Pi", "-", "eps"}], ",", "nt"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.675970862622427*^9, 3.675970863253249*^9}, 
