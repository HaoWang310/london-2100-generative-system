  3.391712136191661*^9}},ExpressionUUID->"5a7cba06-1d3c-44ea-9733-\
c2d65ba18f5f"],

Cell["The translational period is computed as", "Text",ExpressionUUID->"a4b9308a-afaa-42c7-b466-cd769ac7d3cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trans", "=", 
   FractionBox[
    RowBox[{"\[Pi]", " ", 
     SuperscriptBox["R", "2"]}], 
    RowBox[{"1", "+", 
     SuperscriptBox["R", "4"]}]]}], ";"}]], "Input",ExpressionUUID->"d24f2b8b-\
a133-4958-b00f-1fddabc38fd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", "w_", "]"}], ":=", 
