Cell[BoxData[
 RowBox[{
  RowBox[{"mp2", "=", 
   RowBox[{"MeshJoin", "[", 
    RowBox[{"mp1", ",", 
     RowBox[{"MeshRotate", "[", 
      RowBox[{"mp1", ",", 
       RowBox[{"StraightLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.672657887049494*^9, 3.6726578913927298`*^9}, {
