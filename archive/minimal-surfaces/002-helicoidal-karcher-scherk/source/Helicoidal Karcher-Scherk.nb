Cell[BoxData[
 RowBox[{
  RowBox[{"f0", "[", "z_", "]"}], " ", ":=", " ", 
  RowBox[{"Re", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"on1", "[", "w", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", "I", ",", " ", "z"}], "}"}]}], "]"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"on2", "[", "w", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", "I", ",", " ", "z"}], "}"}]}], "]"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"on3", "[", "w", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", "I", ",", " ", "z"}], "}"}]}], "]"}]}], "}"}], 
   "]"}]}]], "Input",
