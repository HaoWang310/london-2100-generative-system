    RowBox[{"G", "[", "w", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.391712143188979*^9, 
  3.39171237494977*^9},ExpressionUUID->"5dcea737-441e-4c48-8f60-210935c89af8"]
