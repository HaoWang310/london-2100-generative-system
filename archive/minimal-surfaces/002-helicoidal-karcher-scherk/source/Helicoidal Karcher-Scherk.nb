Notebook[{

Cell[CellGroupData[{
Cell["Helicoidal Karcher-Scherk Surfaces", "Title",
 CellChangeTimes->{{3.739082447591529*^9, 3.739082448741002*^9}, 
   3.739083445841292*^9},ExpressionUUID->"0779f664-d9af-444b-86a6-\
cf3ce0a086b7"],

Cell["Karcher 1982", "Text",
 CellChangeTimes->{{3.749725888521185*^9, 3.749725893943326*^9}, 
   3.749725993587256*^9},ExpressionUUID->"ba61af60-6e05-44ea-b253-\
8a1d50bc5ab0"],

Cell[CellGroupData[{

Cell["Weierstra\[SZ] Data", "Section",ExpressionUUID->"6d0c1a82-4863-4efa-863b-08b14f0d006d"],

Cell["\<\
We use the upper half plane to parameterize 1/(2k) of a translational \
fundamental piece of the surface.
The Parameter k is the half the number of ends, and Pi*a is the twist angle.\
\>", "Text",ExpressionUUID->"8de92539-aaa0-42da-827a-5511db9afe89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phi1", "[", "w_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["R", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["R", "2"], "-", "w"}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "a"}]], " ", 
    SuperscriptBox["w", 
     RowBox[{"1", "-", 
      FractionBox["1", "k"]}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        SuperscriptBox["R", "2"], " ", "w"}]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "-", "a"}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phi2", "[", "w_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", 
    SuperscriptBox["R", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["R", "2"], "-", "w"}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "-", "a"}]], " ", 
    SuperscriptBox["w", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["1", "k"]}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        SuperscriptBox["R", "2"], " ", "w"}]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "a"}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dh", "[", "w_", "]"}], " ", ":=", 
   FractionBox[
    RowBox[{"I", "/", "2"}], 
    RowBox[{"w", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"R", "^", "2"}]}], "-", 
       RowBox[{"R", "^", "2"}], "-", 
       RowBox[{"1", "/", "w"}], "+", "w"}], ")"}]}]]}], ";"}]}], "Input",
 Background->None,ExpressionUUID->"c84649d6-4574-4e11-a4af-0de91d6ba384"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "[", "w_", "]"}], ":=", 
  RowBox[{"\[ImaginaryI]", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["R", "2"], "-", "w"}], ")"}], "a"], " ", 
   SuperscriptBox["w", 
    RowBox[{" ", 
     RowBox[{"1", "-", 
      FractionBox["1", "k"]}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["R", "2"], " ", "w"}]}], ")"}], 
    RowBox[{"-", "a"}]]}]}]], "Input",
 CellChangeTimes->{{3.39171209731001*^9, 
  3.3917121042207613`*^9}},ExpressionUUID->"71be305d-68c1-4e5d-bc3f-\
5085e9e2ff28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"on1", "[", "z_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "1"}], "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"phi1", "[", "z", "]"}], "-", 
     RowBox[{"phi2", "[", "z", "]"}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"on2", "[", "z_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", "I", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"phi2", "[", "z", "]"}], "+", 
     RowBox[{"phi1", "[", "z", "]"}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"on3", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{"dh", "[", "z", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"9f80a0e3-d416-484e-8400-3c0bc3ba6959"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solving the period problem", "Section",ExpressionUUID->"d2fd348e-6ff3-4c95-94cf-41265d77c2d1"],

Cell["Integrated period integrals -- this speeds up period closing", "Text",
 CellChangeTimes->{{3.739082497693211*^9, 
  3.739082500610551*^9}},ExpressionUUID->"d281a5d9-f3e0-4965-ab2b-\
9d95960ab41b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pphi1", "[", 
     RowBox[{"k_", ",", "a_"}], "]"}], "[", "R_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["R", 
     RowBox[{"4", "+", 
      RowBox[{"2", " ", "a"}], "-", 
      FractionBox["2", "k"]}]], " ", 
    RowBox[{"Gamma", "[", "a", "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"2", "-", 
      FractionBox["1", "k"]}], "]"}], " ", 
    RowBox[{"Hypergeometric2F1Regularized", "[", 
     RowBox[{
      RowBox[{"1", "+", "a"}], ",", 
      RowBox[{"2", "-", 
       FractionBox["1", "k"]}], ",", 
      RowBox[{"2", "+", "a", "-", 
       FractionBox["1", "k"]}], ",", 
      RowBox[{"-", 
       SuperscriptBox["R", "4"]}]}], "]"}]}]}], ";"}]], "Input",ExpressionUUID\
->"9164d02f-6f43-4f3e-b09a-c70177b70b88"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pphi2", "[", 
    RowBox[{"k_", ",", "a_"}], "]"}], "[", "R_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], "  ", 
   SuperscriptBox["R", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"a", "+", 
       FractionBox["1", "k"]}], ")"}]}]], " ", 
   RowBox[{"Gamma", "[", "a", "]"}], " ", 
   RowBox[{"Gamma", "[", 
    FractionBox["1", "k"], "]"}], " ", 
   RowBox[{"Hypergeometric2F1Regularized", "[", 
    RowBox[{
     RowBox[{"1", "+", "a"}], ",", 
     FractionBox["1", "k"], ",", 
     RowBox[{"a", "+", 
      FractionBox["1", "k"]}], ",", 
     RowBox[{"-", 
      FractionBox["1", 
       SuperscriptBox["R", "4"]]}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"ef1b3263-e346-4dec-899d-e6f419e8eb36"],

Cell["Period Condition:", "Text",ExpressionUUID->"2f965430-0c60-4bde-a2ab-67def1ede3d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"test", "[", 
    RowBox[{
     RowBox[{"k_", "?", "NumericQ"}], ",", 
     RowBox[{"a_", "?", "NumericQ"}]}], "]"}], "[", 
   RowBox[{"R_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"pphi2", "[", 
       RowBox[{"k", ",", "a"}], "]"}], "[", "R", "]"}], "/", 
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"a", " ", "Pi"}], "+", 
       RowBox[{"Pi", "/", "k"}]}], "]"}]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"a", " ", "Pi"}], "]"}], "-", 
      RowBox[{"Sin", "[", " ", 
       RowBox[{"Pi", "/", "k"}], "]"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"pphi1", "[", 
     RowBox[{"k", ",", "a"}], "]"}], "[", "R", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.739082512421442*^9, 3.7390825414987392`*^9}, 
   3.739082700076664*^9},ExpressionUUID->"b4742ed9-a6f3-4d8f-b12d-\
68dd7f098d5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SolvePeriod", "[", 
   RowBox[{"k_", ",", "a_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "R0", "}"}], ",", 
    RowBox[{"R0", "/.", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"test", "[", 
         RowBox[{"k", ",", "a"}], "]"}], "[", "R0", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"R0", ",", ".5", ",", ".99"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.7390826461864777`*^9},ExpressionUUID->"9c530992-bc21-476c-a456-\
630e8c99b9b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Defining the surface", "Section",ExpressionUUID->"5d6a5f1c-d1c2-46e9-9326-717719ca54ae"],

Cell["\<\
Choose an integer k>2 and
a real number a between 0 and 1/k. 
R is determined to solve a period condition. \
\>", "Text",
 CellChangeTimes->{{3.739082604417232*^9, 
  3.739082620693025*^9}},ExpressionUUID->"eed52ca8-08d3-453d-8549-\
c41c253babda"],

Cell["\<\
2k: Number of wings, k should be between 2 and 5.
a: twist parameter:
\ta=0:no twist, 
\ta=1/k strong twist. 
\tThe limit cases do not work properly.
If you change the values below, you will need to execute all cells below \
manually.\
\>", "Text",ExpressionUUID->"d03d913c-7c4f-4b6d-8328-bb3fed34a831"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", ".05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"R", "=", 
  RowBox[{"SolvePeriod", "[", 
   RowBox[{"k", ",", "a"}], "]"}]}]}], "Input",
 CellChangeTimes->{
  3.391710804617825*^9, {3.391710863398088*^9, 3.391710883910597*^9}, 
   3.391710943813006*^9, 3.3917109940671053`*^9, 3.675970627351245*^9, {
