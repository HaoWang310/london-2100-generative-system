d67624a9f409"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m2", "=", 
   RowBox[{"MeshApply", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{"E", "^", "#"}], "+", 
         RowBox[{"R", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", " ", 
           RowBox[{"E", "^", "#"}]}], 
          RowBox[{"R", "^", "2"}]}], "+", "1"}], ")"}]}], "&"}], ",", "m1"}], 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"2da3fd63-f4e4-4d63-bb93-\
3e8d1f010429"]
}, Closed]],

Cell[CellGroupData[{

